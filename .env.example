# RateChecker API — environment variables
# Copy to .env and fill in real values before running.

# Database
# Local SQLite (no VOA data — engine will return "Insufficient Data"):
DATABASE_URL=sqlite:///./ratechecker.db
# Supabase PostgreSQL (replace YOUR-PASSWORD):
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.ntqvtnstlibpnazyszbo.supabase.co:5432/postgres

# Cloudflare Turnstile (server-side secret key)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Set to "true" to skip captcha verification in local development
SKIP_CAPTCHA=false

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_REPORT=price_...
STRIPE_PRICE_EVIDENCE=price_...

# Frontend base URL (for Stripe success/cancel redirects)
BASE_URL=http://localhost:5173

# PDF report template directory
REPORT_TEMPLATE_DIR=src/templates/reports

# CORS — comma-separated list of allowed origins, or * for all
CORS_ORIGINS=http://localhost:5173
